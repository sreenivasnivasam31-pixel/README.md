        "from": "Helpdesk Admin <admin-support@company-portal-login.org>",
        "subject": "Action Required: Mandatory Password Reset",
        "greeting": "Hello User",
        "body": "Your corporate password expires today. Please click the link to keep your current password: http://corporate-login-portal.org/reset",
        "has_attachment": True,
        "attachment_name": "Update_Patch.exe"
    },
