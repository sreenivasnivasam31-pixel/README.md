def check_password_strength(password):
    length_criteria = len(password) >= 8
    has_uppercase = any(char.isupper() for char in password)
    has_lowercase = any(char.islower() for char in password)
    has_digit = any(char.isdigit() for char in password)
    
    special_characters = "!@#$%^&*()_+-=[]{}|;:',.<>?/`~"
    has_special = any(char in special_characters for char in password)

    suggestions = []
    if not length_criteria:
        suggestions.append("Make the password at least 8 characters long.")
    if not has_uppercase:
        suggestions.append("Include at least one uppercase letter (A-Z).")
    if not has_lowercase:
        suggestions.append("Include at least one lowercase letter (a-z).")
    if not has_digit:
        suggestions.append("Include at least one number (0-9).")
    if not has_special:
        suggestions.append("Include at least one special character (e.g., !@#$%).")

    score = sum([length_criteria, has_uppercase, has_lowercase, has_digit, has_special])

    print("\n--- Password Analysis ---")
    if score == 5:
        print("Strength: STRONG PASSWORD!")
        print("Your password meets all safety criteria.")
    elif 3 <= score < 5:
        print("Strength: MODERATE PASSWORD")
        print("Suggestions to improve:")
        for s in suggestions:
            print(f"- {s}")
    else:
        print("Strength: WEAK PASSWORD")
        print("Suggestions to improve:")
        for s in suggestions:
            print(f"- {s}")

def main():
    print("====================================")
    print("      PASSWORD STRENGTH CHECKER     ")
    print("====================================")
    user_password = input("Enter a password to check: ")
    check_password_strength(user_password)

if __name__ == "__main__":
    main()
